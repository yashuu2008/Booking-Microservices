    {
      "name": "05 - Reverse Proxy Gateway Routing (Via :8080)",
      "description": "Verifies the AuthInGo reverse proxy gateway forwarding requests to HotelService & BookingService with X-User-ID identity header injection.",
      "item": [
        {
          "name": "Proxied: List Hotels (Via Gateway)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{authBaseUrl}}/hotelservice/api/v1/hotels",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "hotelservice",
                "api",
                "v1",
                "hotels"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Proxied: Create Booking (Via Gateway)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const today = new Date();",
                  "const checkIn = new Date(today);",
                  "checkIn.setDate(today.getDate() + 1);",
                  "const checkOut = new Date(today);",
                  "checkOut.setDate(today.getDate() + 3);",
                  "pm.environment.set('proxyBookingCheckIn', checkIn.toISOString().split('T')[0]);",
                  "pm.environment.set('proxyBookingCheckOut', checkOut.toISOString().split('T')[0]);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              },
              {
                "key": "Content-Type",
