              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Booking (Phase 1: Receives Idempotency Key)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const today = new Date();",
                  "const checkIn = new Date(today);",
                  "checkIn.setDate(today.getDate() + 1);",
                  "const checkOut = new Date(today);",
                  "checkOut.setDate(today.getDate() + 3);",
                  "pm.environment.set('bookingCheckIn', checkIn.toISOString().split('T')[0]);",
                  "pm.environment.set('bookingCheckOut', checkOut.toISOString().split('T')[0]);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data) {",
                  "    pm.environment.set('bookingId', jsonData.data.bookingId);",
                  "    pm.environment.set('idempotencyKey', jsonData.data.idempotencyKey);",
                  "    console.log('Captured Booking ID: ' + jsonData.data.bookingId);",
                  "    console.log('Captured Idempotency Key: ' + jsonData.data.idempotencyKey);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"hotelId\": 1,\n  \"roomCategoryId\": 1,\n  \"totalGuests\": 2,\n  \"bookingAmount\": 500,\n  \"checkInDate\": \"{{bookingCheckIn}}\",\n  \"checkOutDate\": \"{{bookingCheckOut}}\"\n}"
            },
            "url": {
              "raw": "{{bookingBaseUrl}}/api/v1/bookings",
              "host": [
                "{{bookingBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Confirm Booking (Phase 2: Atomic Idempotent Finalization)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Booking is CONFIRMED', function() {",
                  "    pm.expect(jsonData.data.status).to.eql('CONFIRMED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{bookingBaseUrl}}/api/v1/bookings/confirm/{{idempotencyKey}}",
              "host": [
                "{{bookingBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "confirm",
                "{{idempotencyKey}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify Idempotency - Retry Finalized Key (Expects 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 for finalized retry', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Error message mentions already finalized', function() {",
                  "    pm.expect(jsonData.message).to.include('already finalized');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{bookingBaseUrl}}/api/v1/bookings/confirm/{{idempotencyKey}}",
              "host": [
                "{{bookingBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "confirm",
                "{{idempotencyKey}}"
              ]
            }
          },
          "response": []
        },
