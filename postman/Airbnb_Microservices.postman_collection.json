    {
      "name": "03 - Booking Service (Port 3001)",
      "description": "Distributed Redlock concurrency control, two-phase idempotent checkout, and async email dispatch.",
      "item": [
        {
          "name": "Health Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bookingBaseUrl}}/api/v1/ping",
